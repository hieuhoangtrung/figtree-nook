# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/figtree_nook"

# API
API_PORT=4000
API_SECRET=your_api_secret_here
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=your_secure_admin_password

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Gmail SMTP or Resend)
EMAIL_FROM=noreply@figtreenook.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password

# Airbnb iCal URL (get from Airbnb host dashboard > Calendar > Export Calendar)
AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX

# Host notification email
HOST_EMAIL=host@gmail.com

# Twilio SMS (optional — get from https://www.twilio.com)
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Pre-arrival message timing (hours before check-in)
PRE_ARRIVAL_HOURS_BEFORE=48

# Property details
NEXT_PUBLIC_PROPERTY_NAME="Figtree Nook"
NEXT_PUBLIC_NIGHTLY_RATE=120
NEXT_PUBLIC_CLEANING_FEE=40
